# ============================================================================
# IPO Fund Dashboard — environment configuration
# No database, no backend storage — this app keeps its data in the browser's
# localStorage. These are the only env vars it needs, all for sign-in.
# Copy this file to `.env.local` for local dev, and set the same keys in your
# hosting provider (Vercel Project Settings → Environment Variables) for prod.
# ============================================================================

# --- Access (shared password, no accounts, no database) ---------------------
# Required: whoever has this password gets full access (add/edit/delete).
APP_ACCESS_PASSWORD=change-me-to-something-only-you-know
# Optional: a second, read-only password. Leave blank/unset if you don't need
# a view-only tier.
APP_VIEWER_PASSWORD=

# --- NextAuth ---------------------------------------------------------------
# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full public URL of the deployed app (no trailing slash). Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# --- Optional: IPO sync sources (client-side) --------------------------------
# Comma-separated "url|Mainboard" / "url|SME" pairs, fetched directly from the
# browser via a public CORS proxy when someone clicks "Sync Now" on the IPO
# page. Must be prefixed NEXT_PUBLIC_ to be readable by browser code. Best
# effort only — see src/lib/clientIpoSync.ts. Leave unset to use the built-in
# default (NSE's upcoming-issues page).
# NEXT_PUBLIC_IPO_SYNC_SOURCES=
