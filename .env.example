# ============================================================================
# IPO Fund Dashboard — environment configuration
# Copy this file to `.env.local` for local dev, and set the same keys in your
# hosting provider (Vercel Project Settings → Environment Variables) for prod.
# ============================================================================

# --- Database (any Postgres provider) ----------------------------------------
# A plain Postgres connection string. Get a free one from Vercel's own
# Storage tab (Create Database -> Postgres -> Connect Project — auto-fills
# this for you), or sign up separately at neon.tech / supabase.com and paste
# their connection string here. See docs/DEPLOYMENT.md.
#
# Using Supabase: use the "Connection Pooler" string (Project -> Connect ->
# Transaction/Session pooler, *.pooler.supabase.com), NOT "Direct connection"
# (db.<ref>.supabase.co) — the direct host often fails to resolve from
# serverless platforms like Vercel (getaddrinfo ENOTFOUND db.<ref>.supabase.co).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Access (shared password — Milestone 1; per-person accounts come later) -
# Required: whoever has this password gets full access (add/edit/delete,
# including manual IPO refresh and viewing data-source health).
APP_ACCESS_PASSWORD=change-me-to-something-only-you-know
# Optional: a second, read-only password.
APP_VIEWER_PASSWORD=
# Optional: what the shared-password login(s) show as their name in the
# sidebar/admin panel, instead of the generic default. Purely cosmetic.
APP_ACCESS_NAME=
APP_VIEWER_NAME=

# --- NextAuth ---------------------------------------------------------------
# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full public URL of the deployed app (no trailing slash). Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# --- Email (forgot-password OTP only) ----------------------------------------
# Required for the self-service "forgot password" flow (/forgot-password) to
# actually send the 4-digit code. Without this set, that flow returns a clear
# "not configured" error instead of silently failing — the shared-password
# and admin-reset recovery paths still work regardless.
# Sign up free at resend.com, create an API key (Dashboard -> API Keys).
RESEND_API_KEY=
# Optional: defaults to Resend's own onboarding@resend.dev, which needs no
# domain setup and works immediately. Set this only once you've verified
# your own domain in Resend (Dashboard -> Domains) and want mail to appear
# to come from it instead, e.g. "IPO Fund Dashboard <noreply@yourdomain.com>".
RESEND_FROM_EMAIL=

# --- Cron / automated IPO sync ------------------------------------------------
# Shared secret required (as ?secret=... or Authorization: Bearer ...) to
# trigger /api/cron/sync-ipos. Vercel automatically sends this as a Bearer
# header for its own Cron Jobs once this is set — no extra wiring needed.
CRON_SECRET=change-me-to-a-long-random-string
