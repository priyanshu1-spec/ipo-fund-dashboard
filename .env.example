# ============================================================================
# IPO Fund Dashboard — environment configuration
# Copy this file to `.env.local` for local dev, and set the same keys in your
# hosting provider (Vercel Project Settings → Environment Variables) for prod.
# See docs/GOOGLE_SHEETS_SETUP.md for how to obtain each value.
# ============================================================================

# --- NextAuth ---------------------------------------------------------------
# Random secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full public URL of the deployed app (no trailing slash). Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (sign-in) --------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Sheets backend (service account) --------------------------------
# From the JSON key file downloaded for your service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences — the app converts them to real newlines at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# The long ID in your Google Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# --- Bootstrap admin ----------------------------------------------------------
# Comma-separated list of emails that always have admin access, even before the
# Access_Control sheet tab has any rows (so you can never lock yourself out).
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- Cron / automated sync ---------------------------------------------------
# Shared secret required (as ?secret=... or Authorization: Bearer ...) to trigger
# /api/cron/sync-ipos and /api/ipos/sync manually or via Vercel Cron.
CRON_SECRET=change-me-to-a-long-random-string
