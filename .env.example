# ============================================================================
# IPO Fund Dashboard — environment configuration
# Copy this file to `.env.local` for local dev, and set the same keys in your
# hosting provider (Vercel Project Settings → Environment Variables) for prod.
# ============================================================================

# --- Database (any Postgres provider) ----------------------------------------
# A plain Postgres connection string. Get a free one from Vercel's own
# Storage tab (Create Database -> Postgres -> Connect Project — auto-fills
# this for you), or sign up separately at neon.tech / supabase.com and paste
# their connection string here. See docs/DEPLOYMENT.md.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Access (shared password — Milestone 1; per-person accounts come later) -
# Required: whoever has this password gets full access (add/edit/delete,
# including manual IPO refresh and viewing data-source health).
APP_ACCESS_PASSWORD=change-me-to-something-only-you-know
# Optional: a second, read-only password.
APP_VIEWER_PASSWORD=

# --- NextAuth ---------------------------------------------------------------
# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full public URL of the deployed app (no trailing slash). Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# --- Cron / automated IPO sync ------------------------------------------------
# Shared secret required (as ?secret=... or Authorization: Bearer ...) to
# trigger /api/cron/sync-ipos. Vercel automatically sends this as a Bearer
# header for its own Cron Jobs once this is set — no extra wiring needed.
CRON_SECRET=change-me-to-a-long-random-string
