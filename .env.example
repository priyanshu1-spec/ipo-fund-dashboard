# ============================================================================
# IPO Fund Dashboard — environment configuration
# Copy this file to `.env.local` for local dev, and set the same keys in your
# hosting provider (Vercel Project Settings → Environment Variables) for prod.
# See docs/DEPLOYMENT.md for the full walkthrough — everything here is
# configured with clicks inside Vercel, no separate consoles needed.
# ============================================================================

# --- Database (any Postgres provider) ----------------------------------------
# A plain Postgres connection string. Works with a free database from Neon
# (neon.tech), Supabase (supabase.com), Vercel's own Postgres storage tab, or
# any other Postgres host — pick whichever free-tier signup you prefer, copy
# its connection string, paste it here. See docs/DEPLOYMENT.md.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Access (bootstrap admin — your own always-working login) ----------------
# These credentials always work, regardless of what's in the database, so you
# can never lock yourself out. Use them for your own first sign-in, then
# create real per-person accounts under Settings -> Manage Users (each with
# their own username/password and a role) for everyone else.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-something-only-you-know

# --- NextAuth ---------------------------------------------------------------
# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full public URL of the deployed app (no trailing slash). Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# --- Cron / automated sync ---------------------------------------------------
# Shared secret required (as ?secret=... or Authorization: Bearer ...) to trigger
# /api/cron/sync-ipos and /api/ipos/sync manually or via Vercel Cron.
CRON_SECRET=change-me-to-a-long-random-string

# --- Optional: automated IPO data sync sources -------------------------------
# Comma-separated "url|Mainboard" / "url|SME" pairs. See src/lib/scraper.ts —
# this is best-effort; manual entry and Bulk Import JSON always work.
# IPO_SYNC_SOURCES=
